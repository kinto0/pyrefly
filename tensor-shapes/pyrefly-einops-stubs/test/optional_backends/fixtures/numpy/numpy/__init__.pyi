from shape_extensions import IntTuple

# Only the nominal types used by einops signatures are needed, not NumPy's API.
class number: ...
class bool_: ...
class float64(number): ...
class dtype[Scalar]: ...

class ndarray[Shape: IntTuple = IntTuple, DType = dtype[float64]]:
    @property
    def shape(self) -> Shape: ...
    @property
    def dtype(self) -> DType: ...
